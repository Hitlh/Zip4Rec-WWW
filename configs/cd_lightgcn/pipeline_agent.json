  "retrieval": {
    "device": "cuda",
    "epochs": 35,
    "validation_users": 1000,
    "test_users": 1000
  },
  "grpo_config": "configs/cd_lightgcn/grpo.json",
  "sft_learning_rate": 1e-05,
  "layout_optimizer_config": "configs/cd_lightgcn/layout_optimizer.json"
}
