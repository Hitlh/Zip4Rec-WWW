{
  "reviews": "data/raw/CDs_and_Vinyl.jsonl.gz",
  "metadata": "data/raw/meta_CDs_and_Vinyl.jsonl.gz",
  "base_model": "data/models/Qwen3-VL-8B-Instruct",
  "output": "artifacts/zip4rec_cd_agent",
  "asset_model": "gpt-4o",
  "asset_workers": 1,
  "filtering": {
